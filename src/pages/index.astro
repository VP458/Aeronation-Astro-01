---
import {
  OPTION_GROUPS,
  DEFAULT_STATE,
  computeSpecs,
  hasPlaceholderData,
} from "../config/options";

const initialSpecs = computeSpecs(DEFAULT_STATE);
const unverified = hasPlaceholderData();
export const prerender = true;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reconnaître Recon — Configurator</title>
    <meta
      name="description"
      content="Configure the Reconnaître Recon VTOL fixed-wing surveillance drone: payload, energy fit and finish, with live specification readouts."
    />
    <style>
      /* ── Instrument palette ─────────────────────────────────────────
         Deliberately avionics-derived: panel slate, phosphor readouts,
         amber for caution states. Replace with brand tokens when the
         Reconnaître palette is confirmed (see README). */
      :root {
        --panel-0: #101519; /* stage floor */
        --panel-1: #161d23; /* panel face */
        --panel-2: #1e2831; /* raised key */
        --line-0: #2c3944; /* hairline */
        --line-1: #43545f;
        --text-0: #d4dde3; /* primary */
        --text-1: #8da0ab; /* secondary */
        --readout: #79d0b8; /* phosphor */
        --caution: #d8a03c; /* amber */
        --focus: #9ed3ff;
        --mono: "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", monospace;
        --sans: system-ui, "Segoe UI", "Helvetica Neue", sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--panel-0);
        color: var(--text-0);
        font-family: var(--sans);
        min-height: 100dvh;
      }
      :focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
        border-radius: 2px;
      }

      .frame {
        display: grid;
        grid-template-rows: auto 1fr;
        min-height: 100dvh;
        max-width: 1440px;
        margin: 0 auto;
      }

      /* Masthead: identification strip, not a headline stack. */
      .masthead {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--line-0);
        font-family: var(--mono);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
      }
      .masthead .type { color: var(--text-0); }
      .masthead .desig { color: var(--text-1); }
      .masthead .flag {
        margin-left: auto;
        color: var(--caution);
        border: 1px solid color-mix(in srgb, var(--caution) 55%, transparent);
        padding: 0.15rem 0.5rem;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
      }

      .deck {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        min-height: 0;
      }

      /* ── Stage ── */
      .stage {
        position: relative;
        display: grid;
        grid-template-rows: 1fr auto;
        min-height: 420px;
        background:
          radial-gradient(120% 90% at 50% 42%, #1a232b 0%, var(--panel-0) 68%);
      }
      .stage canvas {
        width: 100%;
        height: 100%;
        display: block;
        touch-action: pan-y;
        cursor: grab;
      }
      .stage canvas:active { cursor: grabbing; }

      .stage .hud {
        position: absolute;
        top: 0.75rem;
        left: 1rem;
        right: 1rem;
        display: flex;
        justify-content: space-between;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        color: var(--text-1);
        pointer-events: none;
      }
      .hud .hdg b { color: var(--readout); font-weight: 500; }
      .hud .seq { color: var(--caution); }

      .veil {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        gap: 0.8rem;
        justify-items: center;
        background: color-mix(in srgb, var(--panel-0) 72%, transparent);
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        color: var(--text-1);
        transition: opacity 240ms ease;
      }
      .veil[hidden] { display: none; }
      .veil .bar {
        width: 180px;
        height: 2px;
        background: var(--line-0);
        overflow: hidden;
        position: relative;
      }
      .veil .bar::after {
        content: "";
        position: absolute;
        inset: 0;
        width: 40%;
        background: var(--readout);
        animation: sweep 1.1s linear infinite;
      }
      @keyframes sweep {
        from { transform: translateX(-100%); }
        to { transform: translateX(350%); }
      }
      .veil.error { color: var(--caution); }
      .veil.error .bar { display: none; }

      /* Spec strip under the stage */
      .specs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--line-0);
      }
      .spec {
        padding: 0.7rem 1rem 0.8rem;
        border-right: 1px solid var(--line-0);
      }
      .spec:last-child { border-right: 0; }
      .spec .k {
        font-family: var(--mono);
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-1);
      }
      .spec .v {
        font-family: var(--mono);
        font-size: 1.25rem;
        color: var(--readout);
        margin-top: 0.15rem;
      }
      .spec .v[data-ph="true"] { color: var(--caution); }
      .spec .v small {
        font-size: 0.7rem;
        color: var(--text-1);
        margin-left: 0.3rem;
      }

      /* ── Panel ── */
      .panel {
        border-left: 1px solid var(--line-0);
        background: var(--panel-1);
        padding: 1.1rem 1.1rem 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        overflow-y: auto;
      }
      .panel fieldset {
        border: 1px solid var(--line-0);
        margin: 0;
        padding: 0.75rem 0.75rem 0.85rem;
      }
      .panel legend {
        font-family: var(--mono);
        font-size: 0.64rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-1);
        padding: 0 0.4rem;
      }
      .choice { position: relative; margin-top: 0.45rem; }
      .choice:first-of-type { margin-top: 0.1rem; }
      .choice input {
        position: absolute;
        opacity: 0;
        inset: 0;
        margin: 0;
        cursor: pointer;
      }
      .choice label {
        display: block;
        padding: 0.5rem 0.65rem;
        border: 1px solid var(--line-0);
        background: var(--panel-2);
        cursor: pointer;
        transition: border-color 120ms ease, background 120ms ease;
      }
      .choice .t {
        font-size: 0.85rem;
        letter-spacing: 0.02em;
      }
      .choice .d {
        display: block;
        margin-top: 0.15rem;
        font-size: 0.72rem;
        color: var(--text-1);
      }
      .choice input:checked + label {
        border-color: var(--readout);
        background: color-mix(in srgb, var(--readout) 9%, var(--panel-2));
      }
      .choice input:checked + label .t::before {
        content: "▪ ";
        color: var(--readout);
      }
      .choice input:focus-visible + label {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
      }

      .panel .note {
        font-family: var(--mono);
        font-size: 0.66rem;
        line-height: 1.6;
        letter-spacing: 0.04em;
        color: var(--text-1);
        border-top: 1px solid var(--line-0);
        padding-top: 0.9rem;
      }
      .panel .note b { color: var(--caution); font-weight: 500; }

      .linkline {
        display: flex;
        gap: 0.6rem;
        align-items: center;
      }
      .linkline button {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-0);
        background: var(--panel-2);
        border: 1px solid var(--line-1);
        padding: 0.45rem 0.7rem;
        cursor: pointer;
      }
      .linkline button:hover { border-color: var(--readout); }
      .linkline .copied { color: var(--readout); font-family: var(--mono); font-size: 0.68rem; }

      /* Load choreography: settle + fade, sequenced. */
      @media (prefers-reduced-motion: no-preference) {
        .stage { animation: settle 640ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
        .panel fieldset,
        .panel .note,
        .panel .linkline {
          animation: rise 480ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        .panel fieldset:nth-of-type(1) { animation-delay: 240ms; }
        .panel fieldset:nth-of-type(2) { animation-delay: 340ms; }
        .panel fieldset:nth-of-type(3) { animation-delay: 440ms; }
        .panel .linkline { animation-delay: 540ms; }
        .panel .note { animation-delay: 620ms; }
        @keyframes settle {
          from { opacity: 0; transform: translateY(10px); }
          to { opacity: 1; transform: none; }
        }
        @keyframes rise {
          from { opacity: 0; transform: translateY(8px); }
          to { opacity: 1; transform: none; }
        }
      }

      /* ── Mobile: full-bleed stage, bottom-sheet panel ── */
      @media (max-width: 820px) {
        .deck { grid-template-columns: 1fr; }
        .stage { min-height: 62dvh; }
        .specs { grid-template-columns: repeat(2, 1fr); }
        .spec:nth-child(2) { border-right: 0; }
        .panel {
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 10;
          border-left: 0;
          border-top: 1px solid var(--line-1);
          max-height: 62dvh;
          transform: translateY(calc(100% - 3.1rem));
          transition: transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
          padding-top: 0;
        }
        .panel.open { transform: translateY(0); }
        .sheet-handle {
          position: sticky;
          top: 0;
          display: flex;
          width: 100%;
          align-items: center;
          justify-content: space-between;
          background: var(--panel-1);
          color: var(--text-0);
          border: 0;
          border-bottom: 1px solid var(--line-0);
          font-family: var(--mono);
          font-size: 0.7rem;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          padding: 1rem 0.2rem 0.9rem;
          cursor: pointer;
        }
        @media (prefers-reduced-motion: reduce) {
          .panel { transition: none; }
        }
        body { padding-bottom: 3.2rem; }
      }
      @media (min-width: 821px) {
        .sheet-handle { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="frame">
      <header class="masthead">
        <span class="type">RECONNAÎTRE&nbsp;RECON</span>
        <span class="desig">VTOL FIXED-WING · SURVEILLANCE</span>
        {unverified && <span class="flag" title="Specification data is placeholder pending programme confirmation">UNVERIFIED DATA</span>}
      </header>

      <main class="deck">
        <section class="stage" aria-label="Airframe viewer">
          <canvas
            id="turntable"
            tabindex="0"
            role="img"
            aria-label="Reconnaître Recon airframe, rotatable. Drag or use arrow keys to rotate."
          ></canvas>
          <div class="hud" aria-hidden="true">
            <span class="hdg">HDG <b id="hdg">000</b>°</span>
            <span class="seq" id="seq-flag"></span>
          </div>
          <div class="veil" id="veil">
            <span>ACQUIRING FRAME SEQUENCE</span>
            <span class="bar"></span>
          </div>
          <div class="specs" id="specs" aria-live="polite">
            {initialSpecs.map((s) => (
              <div class="spec" data-spec={s.id}>
                <div class="k">{s.label}</div>
                <div class="v" data-ph={String(s.placeholder)} title={s.placeholder ? "Placeholder figure — unverified" : undefined}>
                  <span data-value>{s.value}</span><small>{s.unit}</small>
                </div>
              </div>
            ))}
          </div>
        </section>

        <aside class="panel" id="panel" aria-label="Configuration panel">
          <button class="sheet-handle" id="sheet-toggle" aria-expanded="false" aria-controls="panel">
            <span>CONFIGURE</span>
            <span aria-hidden="true">▴</span>
          </button>
          <form id="config-form">
            {OPTION_GROUPS.map((group) => (
              <fieldset>
                <legend>{group.label}</legend>
                {group.choices.map((choice) => (
                  <div class="choice">
                    <input
                      type="radio"
                      name={group.id}
                      value={choice.id}
                      id={`${group.id}-${choice.id}`}
                      checked={DEFAULT_STATE[group.id] === choice.id}
                    />
                    <label for={`${group.id}-${choice.id}`}>
                      <span class="t">{choice.label}</span>
                      {choice.detail && <span class="d">{choice.detail}</span>}
                    </label>
                  </div>
                ))}
              </fieldset>
            ))}
          </form>
          <div class="linkline">
            <button type="button" id="copy-link">Copy build link</button>
            <span class="copied" id="copied" role="status"></span>
          </div>
          <p class="note">
            {unverified && (
              <>
                <b>UNVERIFIED:</b> option names and figures are placeholders pending
                programme confirmation — see README.{" "}
              </>
            )}
            Viewer sequence is a schematic placeholder, not the production
            airframe render.
          </p>
        </aside>
      </main>
    </div>

    <script>
      import { createTurntableViewer } from "../configurator/viewer";
      import { parseStateFromUrl, writeStateToUrl } from "../configurator/url-state";
      import { computeSpecs, DEFAULT_STATE } from "../config/options";
      import type { ConfigState, FramesManifest } from "../configurator/types";

      const canvas = document.getElementById("turntable") as HTMLCanvasElement;
      const veil = document.getElementById("veil") as HTMLElement;
      const hdg = document.getElementById("hdg") as HTMLElement;
      const seqFlag = document.getElementById("seq-flag") as HTMLElement;
      const form = document.getElementById("config-form") as HTMLFormElement;
      const specsRoot = document.getElementById("specs") as HTMLElement;

      function showError(message: string) {
        veil.hidden = false;
        veil.classList.add("error");
        veil.innerHTML = "";
        const line = document.createElement("span");
        line.textContent = message;
        veil.appendChild(line);
      }

      function readFormState(): ConfigState {
        const data = new FormData(form);
        return {
          colourway: String(data.get("colourway") ?? DEFAULT_STATE.colourway),
          payload: String(data.get("payload") ?? DEFAULT_STATE.payload),
          endurance: String(data.get("endurance") ?? DEFAULT_STATE.endurance),
        };
      }

      function applyStateToForm(state: ConfigState) {
        for (const [group, value] of Object.entries(state)) {
          const input = form.querySelector<HTMLInputElement>(
            `input[name="${group}"][value="${value}"]`
          );
          if (input) input.checked = true;
        }
      }

      function renderSpecs(state: ConfigState) {
        for (const spec of computeSpecs(state)) {
          const box = specsRoot.querySelector(`[data-spec="${spec.id}"] .v`);
          const el = box?.querySelector("[data-value]");
          if (el) el.textContent = spec.value;
          if (box) box.setAttribute("data-ph", String(spec.placeholder));
        }
      }

      async function boot() {
        let manifest: FramesManifest;
        try {
          const res = await fetch("/frames/manifest.json");
          if (!res.ok) throw new Error(String(res.status));
          manifest = await res.json();
        } catch {
          showError("Frame sequence unavailable — regenerate with npm run frames:placeholder.");
          return;
        }

        const initial = parseStateFromUrl(location.search, DEFAULT_STATE);
        const initialAz = (() => {
          const az = Number(new URLSearchParams(location.search).get("az"));
          return Number.isInteger(az) && az >= 0 && az < manifest.frameCount ? az : 0;
        })();

        const startState: ConfigState = initial;
        applyStateToForm(startState);
        renderSpecs(startState);
        if (manifest.placeholder) seqFlag.textContent = "PLACEHOLDER SEQUENCE";

        const viewer = createTurntableViewer(canvas, {
          manifest,
          initialState: startState,
          initialIndex: initialAz,
          autoRotate: 6,
        });

        let currentState = startState;
        const degPerFrame = 360 / manifest.frameCount;

        viewer.on("sequenceready", () => {
          veil.hidden = true;
        });
        viewer.on("framechange", (detail) => {
          const index = typeof detail === "number" ? detail : viewer.getIndex();
          hdg.textContent = String(Math.round(index * degPerFrame) % 360).padStart(3, "0");
          writeStateToUrl(currentState, index);
        });
        viewer.on("error", () => {
          showError("Payload configuration unavailable for this airframe.");
        });

        form.addEventListener("change", () => {
          currentState = readFormState();
          renderSpecs(currentState);
          viewer.setConfig(currentState);
          writeStateToUrl(currentState, viewer.getIndex());
        });

        const copyBtn = document.getElementById("copy-link") as HTMLButtonElement;
        const copied = document.getElementById("copied") as HTMLElement;
        copyBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(location.href);
            copied.textContent = "COPIED";
          } catch {
            copied.textContent = location.href;
          }
          setTimeout(() => (copied.textContent = ""), 2400);
        });
      }

      // Mobile bottom sheet
      const panel = document.getElementById("panel") as HTMLElement;
      const toggle = document.getElementById("sheet-toggle") as HTMLButtonElement;
      toggle?.addEventListener("click", () => {
        const open = panel.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
        const arrow = toggle.querySelector("[aria-hidden]");
        if (arrow) arrow.textContent = open ? "▾" : "▴";
      });

      boot();
    </script>
  </body>
</html>
