{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeronation-astro-01",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeronation-db",
      // Replace with the real id printed by `npm run db:create`
      // (wrangler d1 create aeronation-db). Local dev works without it.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
